server {
    listen 8444 ssl;
    server_name vigilant.selfip.com;
    ssl_certificate /etc/letsencrypt/live/vigilant.selfip.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vigilant.selfip.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    client_max_body_size 1m;
    access_log /var/log/nginx/villas-beer.access.log;
    error_log /var/log/nginx/villas-beer.error.log;

    location / {
        proxy_pass http://127.0.0.1:8770;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
